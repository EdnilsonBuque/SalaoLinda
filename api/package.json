{
  "name": "salao-linda-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "migrate:latest": "node --env-file=.env node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.js",
    "migrate:rollback": "node --env-file=.env node_modules/knex/bin/cli.js migrate:rollback --knexfile knexfile.js",
    "migrate:status": "node --env-file=.env node_modules/knex/bin/cli.js migrate:status --knexfile knexfile.js",
    "bootstrap:admin": "node --env-file=.env src/scripts/bootstrap-admin.js",
    "bootstrap:especialists": "node --env-file=.env src/scripts/bootstrap-specialists.js",
    "test": "node --env-file=.env --test test/"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  }
}
